{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "主窗口最小权限：只开放对话框；文件读写、钥匙串、模型请求都走自定义命令",
  "windows": ["main"],
  "permissions": ["core:default", "dialog:allow-open", "dialog:allow-save", { "identifier": "opener:allow-open-url", "allow": [{ "url": "https://github.com/*" }, { "url": "https://muoushikoma.github.io/*" }] }]
}
